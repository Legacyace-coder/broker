  void copy.offsetWidth;
  copy.classList.add('is-changing');
  if(announce)status.textContent=`${slide.label}: ${slide.copy}`;
 };
 const stop=()=>{window.clearInterval(timer);timer=undefined;};
 const start=()=>{stop();if(!pointerPaused&&!focusPaused&&!reduceMotion.matches&&!document.hidden)timer=window.setInterval(()=>render(active+1),6500);};
 dots.forEach((button,index)=>button.addEventListener('click',()=>{render(index,true);start();}));
 $('[data-hero-prev]',hero).addEventListener('click',()=>{render(active-1,true);start();});
