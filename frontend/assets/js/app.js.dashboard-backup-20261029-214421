async function redirectForVerifiedRole({signOutUnknown=false}={}){
  const client = await getSupabase();
  const {data:{session:activeSession}} = await client.auth.getSession();

  if (!activeSession?.access_token) return false;

  const me = await api('/api/me');
  const target = portalForRole(me?.profile?.role);

  if (target) {
    location.replace(target);
    return true;
  }

  if (signOutUnknown) await client.auth.signOut();
  return false;
}

async function api(path,options={}){const s=await session();if(!s?.access_token)throw new Error('Please sign in first.');const headers={'Authorization':`Bearer ${s.access_token}`,...(options.headers||{})};if(!(options.body instanceof FormData)&&options.body!==undefined&&!headers['Content-Type'])headers['Content-Type']='application/json';const r=await fetch(`${API}${path}`,{...options,headers});let body={};try{body=await r.json()}catch{}if(!r.ok)throw new Error(body.detail||body.message||'Request failed');return body;}
